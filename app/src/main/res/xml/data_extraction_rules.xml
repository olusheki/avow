<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- HMAC key is device-bound (AndroidKeyStore); restoring signed prefs elsewhere trips the
             tamper fallback. Exclude the vow settings from cloud backup. -->
        <exclude domain="file" path="datastore/vow_settings.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/vow_settings.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>

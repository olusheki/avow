<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31.
-->
<full-backup-content>
    <!-- The vow settings are HMAC-signed with a non-exportable AndroidKeyStore key. Restoring the
         prefs onto a new device (where the key is absent) would fail the signature check and force
         the strict 7-day fallback lockout, so exclude them from backup. -->
    <exclude domain="file" path="datastore/vow_settings.preferences_pb"/>
</full-backup-content>

<!--
  aVow notification small icon: the mascot smiley as a monochrome silhouette.
  Android renders only the alpha of a small icon, so everything is opaque white and gets
  tinted by NotificationCompat.setColor() at display time. Geometry mirrors SmileyFaceOutline
  (200x200 viewport): face r=80 @ (100,100), eyes r=10 @ (75,82)/(125,82), smile bezier.
  Eyes are filled dots (not rings) so they survive being scaled down to the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <!-- Face boundary -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="11"
        android:fillColor="#00000000"
        android:pathData="M20,100 a80,80 0 1,0 160,0 a80,80 0 1,0 -160,0" />
    <!-- Left eye (filled) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M62,82 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" />
    <!-- Right eye (filled) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M112,82 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" />
    <!-- Smile -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M60,130 C60,130 75,150 100,150 C125,150 140,130 140,130" />
</vector>
